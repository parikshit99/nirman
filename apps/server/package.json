{
  "name": "@nirman/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nirman/shared": "*",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.4",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
