# Postgres connection string. `docker compose up -d db` from the repo root starts one matching this.
DATABASE_URL="postgres://nirman:nirman@localhost:5432/nirman"

# Secret used to sign access tokens. Use a long random value in production (openssl rand -hex 32).
JWT_SECRET="change-me-to-a-long-random-string-of-32+-chars"

# Google Gemini key used for AI extraction. It stays on the server and is never shipped in the app.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3-flash-preview"

# PORT=8080
# Comma-separated list of extra allowed browser origins (the Android app and local dev are allowed by default).
# CORS_ORIGINS="https://example.com"
